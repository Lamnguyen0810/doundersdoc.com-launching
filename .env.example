# --- App ---
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000

# --- Database (Supabase → Project Settings → Database → connection string, session pooler) ---
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Local dev without Supabase: DATABASE_URL=sqlite:///./jessica.db

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Optional: legacy HS256 secret. Leave blank to verify via JWKS (recommended).
SUPABASE_JWT_SECRET=

# --- Storage: "supabase" (private bucket) or "local" (dev only) ---
STORAGE_BACKEND=local
STORAGE_BUCKET=documents
LOCAL_STORAGE_DIR=./local_storage

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_REVIEW=claude-sonnet-5
CLAUDE_MODEL_ASK=claude-sonnet-5

# --- Retention ---
DOCUMENT_RETENTION_DAYS=30
ANON_RETENTION_HOURS=24

# --- Optional ---
SENTRY_DSN=
